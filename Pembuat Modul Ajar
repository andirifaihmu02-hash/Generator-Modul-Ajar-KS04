    const blob = new Blob(
        [fullHTML],
        {
            type:"application/msword"
        }
    );


    const url = URL.createObjectURL(blob);

    const a = document.createElement("a");

    a.href = url;

    a.download =
        `Modul_Ajar_${mapelSafe()}_${kelasSafe()}.doc`;

    document.body.appendChild(a);

    a.click();

    a.remove();

    URL.revokeObjectURL(url);

