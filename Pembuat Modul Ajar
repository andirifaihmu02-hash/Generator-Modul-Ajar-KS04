    kelas.dispatchEvent(new Event("change"));

    document.getElementById("mapel").value =
        "IPAS";

    document.getElementById("elemen").value =
        "Pemahaman IPAS";

    document.getElementById("alokasi").value =
        "120 Menit (3 JP)";

    document.getElementById("target").value =
        "Reguler / Tipikal";

    document.getElementById("cp").value =
        "Peserta didik memahami konsep-konsep utama sesuai fase, menghubungkan pengetahuan dengan fenomena kehidupan sehari-hari, serta menggunakan pengetahuan tersebut untuk menjelaskan dan menyelesaikan permasalahan sederhana.";

    document.getElementById("topik").value =
