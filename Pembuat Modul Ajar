function mapelSafe(){

    return val("mapel")
        .replace(/[^a-zA-Z0-9]+/g,"_")
        .replace(/^_|_$/g,"") || "SD";

}


function kelasSafe(){

    return val("kelas")
        .replace(/[^a-zA-Z0-9]+/g,"_")
        .replace(/^_|_$/g,"") || "Kelas";

}


/* =========================================================
   RESET
========================================================= */

function resetForm(){

    if(!confirm("Reset seluruh formulir?")) return;

    document.querySelectorAll("input, textarea").forEach(el=>{

        if(el.type === "checkbox"){

            el.checked = false;

        }else if(el.id !== "sekolah"){

            el.value = "";

        }

    });


    document.getElementById("sekolah").value =
        SCHOOL_NAME;


    document.getElementById("jenjang").value = "";


    kelas.innerHTML = `
        <option value="" selected disabled>
            Pilih jenjang terlebih dahulu
        </option>
    `;

    kelas.disabled = true;

    fase.value = "";


    document.getElementById("model").value = "";


    document.getElementById("target").value = "";


    document.getElementById("emptyState").classList.remove("hidden");

    document.getElementById("actionToolbar").classList.add("hidden");

    document.getElementById("documentContainer").classList.add("hidden");

    document.getElementById("document").innerHTML = "";

}


