<script>

/* =========================================================
   KONFIGURASI SEKOLAH
========================================================= */

const SCHOOL_NAME = "SDN Kedoya Selatan 04 Pagi";

const PRINCIPAL = "Andi Rifaih, S.Pd";

const PRINCIPAL_NIP = "197410072014121001";

const LOGO_URL = "https://iili.io/CU2uox4.png";


/* =========================================================
   CASCADING KELAS
========================================================= */

const jenjang = document.getElementById("jenjang");
const kelas = document.getElementById("kelas");
const fase = document.getElementById("fase");

jenjang.addEventListener("change", function(){

    kelas.innerHTML = "";

    const placeholder = document.createElement("option");

    placeholder.value = "";
    placeholder.textContent = "Pilih kelas";

    placeholder.disabled = true;
    placeholder.selected = true;

    kelas.appendChild(placeholder);

    if(this.value === "SD/MI"){

        kelas.disabled = false;

        for(let i = 1; i <= 6; i++){

            const option = document.createElement("option");

            option.value = `Kelas ${i}`;

            option.textContent = `Kelas ${i}`;

            kelas.appendChild(option);

        }

    }else{

        kelas.disabled = true;

        fase.value = "";

    }

});


kelas.addEventListener("change", function(){

    const k = parseInt(this.value.replace("Kelas ",""));

    if(k <= 2){

        fase.value = "Fase A";

    }else if(k <= 4){

        fase.value = "Fase B";

    }else if(k <= 6){

        fase.value = "Fase C";

    }else{

        fase.value = "";

    }

});


/* =========================================================
   HELPER
========================================================= */

function val(id){

    return document.getElementById(id)?.value?.trim() || "";

}


function esc(text){

    return String(text || "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


function linesToList(text){

    if(!text) return "<li>Belum diisi.</li>";

    const lines = text
        .split(/\n|;/)
        .map(x => x.trim())
        .filter(Boolean);

    return lines
        .map(x => `<li>${esc(x.replace(/^[-•\d.)]+\s*/,""))}</li>`)
        .join("");

}


function selectedDimensions(){

    return [...document.querySelectorAll(
        'input[type="checkbox"]:checked'
    )].map(x => x.value);

}


function dimensionDescription(dim){

    const descriptions = {

        "Penalaran Kritis":
            "Peserta didik dilatih mengidentifikasi informasi, menganalisis sebab-akibat, menggunakan bukti, serta menyusun kesimpulan berdasarkan alasan yang logis.",

        "Kolaborasi":
            "Peserta didik bekerja dalam kelompok, berbagi peran, menghargai kontribusi teman, dan menyelesaikan tugas bersama.",

        "Kreativitas":
            "Peserta didik menghasilkan gagasan, cara penyelesaian, karya, atau produk yang relevan dan menunjukkan keaslian.",

        "Komunikasi":
            "Peserta didik menyampaikan ide secara lisan, tulisan, visual, maupun presentasi dengan bahasa yang santun dan mudah dipahami.",

        "Kemandirian":
            "Peserta didik mampu mengatur proses belajar, menyelesaikan tugas, dan mengevaluasi hasil belajarnya secara bertanggung jawab.",

        "Kewargaan":
            "Peserta didik menunjukkan kepedulian, tanggung jawab, sikap menghargai keberagaman, dan kontribusi positif di lingkungan.",

        "Keimanan & Ketakwaan":
            "Peserta didik mengembangkan sikap syukur, tanggung jawab, kejujuran, dan perilaku baik dalam proses belajar.",

        "Kesehatan":
            "Peserta didik memahami dan mempraktikkan kebiasaan yang mendukung kesehatan fisik, mental, dan lingkungan."

    };

    return descriptions[dim] || "";

}


/* =========================================================
