function getSyntax(model){

    const syntax = {

        "Problem Based Learning":[
            "Orientasi peserta didik pada masalah",
            "Mengorganisasi peserta didik untuk belajar",
            "Membimbing penyelidikan individu/kelompok",
            "Mengembangkan dan menyajikan hasil karya",
            "Menganalisis dan mengevaluasi proses pemecahan masalah"
        ],

        "Project Based Learning":[
            "Menentukan pertanyaan mendasar",
            "Mendesain perencanaan proyek",
            "Menyusun jadwal kegiatan",
            "Memonitor proses dan perkembangan proyek",
            "Menguji dan mempresentasikan hasil proyek"
        ],

        "Discovery Learning":[
            "Stimulation / pemberian rangsangan",
            "Problem statement / identifikasi masalah",
            "Data collection / pengumpulan data",
            "Data processing / pengolahan data",
            "Verification dan generalization"
        ],

        "Inquiry Learning":[
            "Orientasi masalah",
            "Merumuskan masalah",
            "Mengajukan hipotesis",
            "Mengumpulkan dan menganalisis data",
            "Menarik kesimpulan"
        ],

        "Direct Instruction":[
            "Orientasi dan penyampaian tujuan",
            "Demonstrasi atau pemodelan",
            "Latihan terbimbing",
            "Pengecekan pemahaman",
            "Latihan mandiri dan penguatan"
        ]

    };

    return syntax[model] || [
        "Orientasi pembelajaran",
        "Eksplorasi",
        "Investigasi",
        "Presentasi",
        "Refleksi"
    ];

}


